<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info has no type for either, so AptBIM declares both. application/x-aptbim is
     the content type the Windows installer registers for .aptbim. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-aptbim">
    <comment>AptBIM project</comment>
    <sub-class-of type="application/json"/>
    <generic-icon name="io.github.anuj09k.aptbim"/>
    <glob pattern="*.aptbim"/>
  </mime-type>
  <mime-type type="application/x-ifc">
    <comment>IFC building model</comment>
    <sub-class-of type="text/plain"/>
    <!-- An IFC file is ISO 10303-21 (STEP) text. -->
    <magic priority="50"><match type="string" value="ISO-10303-21;" offset="0"/></magic>
    <glob pattern="*.ifc"/>
  </mime-type>
</mime-info>
